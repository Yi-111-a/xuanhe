{
  "name": "tianbao-app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/link-test-deps.mjs",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "node scripts/check-fonts.mjs && node scripts/link-test-deps.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/link-test-deps.mjs && tsc --noEmit",
    "fonts": "node scripts/subset-fonts.mjs",
    "fonts:check": "node scripts/check-fonts.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:real": "node scripts/run-e2e.mjs --real",
    "screens": "node scripts/run-e2e.mjs --grep @screens"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
